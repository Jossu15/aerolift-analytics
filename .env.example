# Copy to .env and adjust. The API reads DATABASE_URL at startup.
DATABASE_URL=postgresql://aerolift:aerolift_dev_password@localhost:5432/aerolift

# Alert scheduler
#ALERT_SCHEDULER_ENABLED=1
#ALERT_POLL_SECONDS=300

# Slack incoming webhook for alert escalations (unset = disabled no-op)
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx

# SMTP email for alert escalations (unset = disabled no-op)
#EMAIL_SMTP_HOST=smtp.example.com
#EMAIL_SMTP_PORT=587
#EMAIL_SMTP_USER=alerts@aerolift
#EMAIL_SMTP_PASSWORD=secret
#EMAIL_FROM=alerts@aerolift
#EMAIL_TO=ops@company.com, ing@company.com
#EMAIL_TLS=1
